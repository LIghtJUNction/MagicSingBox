      {
        "rule_set": ["meta-github", "meta-huggingface", "meta-gitlab", "meta-docker", "meta-npmjs", "meta-category-dev"],
        "server": "doh-google"
      },
      {"rule_set": ["meta-category-games-!cn"], "server": "doh-google"},
      {"rule_set": ["meta-microsoft"], "server": "bootstrap-local-dns"},
      {"rule_set": ["meta-category-scholar-!cn"], "server": "doh-google"},
