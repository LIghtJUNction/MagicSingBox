{
  "log": {"level": "error", "timestamp": true},
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "bootstrap-local-dns",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "headers": {"Host": "dns.alidns.com"},
        "tls": {"server_name": "dns.alidns.com"}
      },
      {
        "type": "https",
        "tag": "doh-google",
        "detour": "proxy",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {"server_name": "dns.google"}
      },
      {
        "type": "https",
        "tag": "doh-cloudflare",
        "detour": "proxy",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {"enabled": true, "server_name": "cloudflare-dns.com"}
      }
    ],
    "rules": [
      {"protocol": "icmp", "server": "doh-google"},
      {"clash_mode": "Direct", "server": "bootstrap-local-dns"},
      {"clash_mode": "Global", "server": "doh-cloudflare"},
      {"domain_suffix": ["local", "home.arpa", "lan"], "server": "bootstrap-local-dns"},
      {"domain_suffix": ["tailscale.net", "ts.net"], "server": "bootstrap-local-dns"},
